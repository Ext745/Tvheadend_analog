# Spawn profiles. bwdif with deint=1 deinterlaces only frames flagged interlaced; the
# encoders keep the 8:9 pixel shape, so the picture stays 4:3 unless a profile rescales
# it to square pixels. "gated" profiles are only created if this machine encodes them at
# --min-speed times real time or better. A profile with "variants" tries them in order
# and uses the first that passes (VAAPI: all-GPU first, then software deinterlace).
AAC = "-c:a aac -ac 2 -ar 48000 -b:a {}k"
OPUS = "-c:a libopus -ac 2 -b:a 128k"
X264 = "-c:v libx264 -preset veryfast -pix_fmt yuv420p"
# VAAPI (Intel/AMD GPU). All-GPU: hardware MPEG-2 decode, deinterlace_vaapi (auto=1:
# interlaced frames only), hardware encode -- about a tenth of x264's CPU. Fallback:
# decode + bwdif on the CPU, then upload, for GPUs/drivers that can't deinterlace.
VAAPI_GPU = "-hwaccel vaapi -hwaccel_device {dev} -hwaccel_output_format vaapi"
VAAPI_UPLOAD = "-vaapi_device {dev}"


def vaapi(gpu_vf, sw_vf, venc):
    return [{"label": "all-GPU", "pre": VAAPI_GPU, "vf": gpu_vf, "venc": venc},
            {"label": "software deinterlace + GPU encode", "pre": VAAPI_UPLOAD,
             "vf": f"{sw_vf},format=nv12,hwupload", "venc": venc}]


def vaapi_scaled(gpu_vf, sw_vf, scale, venc):
    return [{"label": "all-GPU", "pre": VAAPI_GPU, "vf": f"{gpu_vf},{scale}", "venc": venc},
            {"label": "software deinterlace + GPU encode", "pre": VAAPI_UPLOAD,
             "vf": f"{sw_vf},format=nv12,hwupload,{scale}", "venc": venc}]


