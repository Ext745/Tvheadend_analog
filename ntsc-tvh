CONF_PATH = "/etc/ntsc-tvh.conf"


def load_config():
    cfg = dict(DEFAULTS)
    if os.path.isfile(CONF_PATH):
        try:
            with open(CONF_PATH) as fh:
                for line in fh:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = re.sub(r"\s+#.*$", "", v)   # inline "  # comment" (a '#' inside a value is kept)
                    v = v.strip().strip('"').strip("'")
                    if k in cfg:
                        cfg[k] = v
        except OSError as exc:
            print(f"warning: could not read {CONF_PATH}: {exc}", file=sys.stderr)
    for k in cfg:
        if k in os.environ:
            cfg[k] = os.environ[k]
    return cfg


# --------------------------------------------------------------------------- #
#  NTSC / CATV frequency plans  (visual / picture carrier, MHz)
#  Verified against FCC 73.603 (broadcast) and EIA-542 STD/IRC/HRC (cable).
# --------------------------------------------------------------------------- #
def bcast_freq(ch):
    if 2 <= ch <= 4:    return 55.25 + (ch - 2) * 6      # 55.25 / 61.25 / 67.25
    if 5 <= ch <= 6:    return 77.25 + (ch - 5) * 6      # 77.25 / 83.25
    if 7 <= ch <= 13:   return 175.25 + (ch - 7) * 6     # 175.25 .. 211.25
    if 14 <= ch <= 69:  return 471.25 + (ch - 14) * 6    # 471.25 .. 801.25
    return None


def cable_std_freq(ch):
    if ch == 1:         return 73.25                     # cable 1 (A-8)
    if 2 <= ch <= 4:    return 55.25 + (ch - 2) * 6
    if 5 <= ch <= 6:    return 77.25 + (ch - 5) * 6
    if 7 <= ch <= 13:   return 175.25 + (ch - 7) * 6
    if 14 <= ch <= 22:  return 121.25 + (ch - 14) * 6    # midband A..I  121.25 .. 169.25
    if 23 <= ch <= 94:  return 217.25 + (ch - 23) * 6    # superband+    217.25 .. 643.25
    if 95 <= ch <= 99:  return 91.25 + (ch - 95) * 6     # 91.25 .. 115.25 (between FM and ch7)
    if 100 <= ch <= 135: return 649.25 + (ch - 100) * 6  # 649.25 .. 859.25 (comb continues)
    return None


def cable_irc_freq(ch):
    # IRC == STD except channels 5 and 6 sit 2 MHz higher (on the 6-MHz comb).
    f = cable_std_freq(ch)
    if f is None:       return None
    if ch == 5:         return 79.25
    if ch == 6:         return 85.25
    return f


def cable_hrc_freq(ch):
    # HRC: all carriers 1.25 MHz below STD, except 5/6 which are 0.75 MHz above STD.
    f = cable_std_freq(ch)
    if f is None:       return None
    if ch in (5, 6):    return round(f + 0.75, 4)
    return round(f - 1.25, 4)


TABLES = {
    "us-bcast":     {"label": "Broadcast",   "range": range(2, 70),  "freq": bcast_freq,      "group": "Broadcast"},
    "us-cable":     {"label": "Cable STD",   "range": range(1, 136), "freq": cable_std_freq,  "group": "Cable"},
    "us-cable-irc": {"label": "Cable IRC",   "range": range(1, 136), "freq": cable_irc_freq,  "group": "Cable IRC"},
    "us-cable-hrc": {"label": "Cable HRC",   "range": range(1, 136), "freq": cable_hrc_freq,  "group": "Cable HRC"},
}

# Logical line inputs (for VCRs, game consoles, retro computers, etc.)
INPUT_CHANNELS = {
    "composite": {"label": "Composite In", "match": ("composite", "cvbs", "av")},
    "svideo":    {"label": "S-Video In",   "match": ("s-video", "svideo", "s-vid")},
}


class ChannelError(Exception):
    pass


def parse_channel(cid):
    """Return a normalized channel dict from a 'TABLE:CH' or 'input:NAME' id."""
    cid = cid.strip()
    if ":" not in cid:
        raise ChannelError(f"bad channel id '{cid}' (expected TABLE:CH or input:NAME)")
    table, _, rest = cid.partition(":")
    table = table.lower()
    if table == "input":
        name = rest.lower()
        if name not in INPUT_CHANNELS:
            raise ChannelError(f"unknown input '{name}' (have: {', '.join(INPUT_CHANNELS)})")
        return {
            "id": f"input:{name}", "kind": "input", "input": name,
            "label": INPUT_CHANNELS[name]["label"], "group": "Inputs",
            "table": "input", "ch": None, "freq": None,
        }
    if table not in TABLES:
        raise ChannelError(f"unknown table '{table}' (have: {', '.join(TABLES)})")
    try:
        ch = int(rest)
    except ValueError:
        raise ChannelError(f"channel must be an integer, got '{rest}'")
    spec = TABLES[table]
    freq = spec["freq"](ch)
    if freq is None:
        raise ChannelError(f"channel {ch} is not defined in table {table}")
    return {
        "id": f"{table}:{ch}", "kind": "tuner", "input": "television",
        "label": f"{spec['label']} {ch}", "group": spec["group"],
        "table": table, "ch": ch, "freq": round(freq, 4),
    }


def all_channels(tables):
    out = []
    for t in tables:
        if t not in TABLES:
            raise ChannelError(f"unknown table '{t}' (have: {', '.join(TABLES)})")
        spec = TABLES[t]
        for ch in spec["range"]:
            if spec["freq"](ch) is not None:
                out.append(parse_channel(f"{t}:{ch}"))
    return out


# --------------------------------------------------------------------------- #
#  Device interaction (v4l2-ctl wrappers)
# --------------------------------------------------------------------------- #
def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def v4l2(cfg, *args):
    return run([cfg["V4L2CTL"], "-d", cfg["DEVICE"], *args])


def device_info(cfg):
    """Probe driver, pixel format (MPEG => hardware encoder), and inputs."""
    r = v4l2(cfg, "--all")
    if r.returncode != 0:
        raise ChannelError(f"v4l2-ctl --all failed: {r.stderr.strip() or r.stdout.strip()}")
    out = r.stdout
    drv = re.search(r"Driver name\s*:\s*(\S+)", out)
    pix = re.search(r"Pixel Format\s*:\s*'?([A-Za-z0-9]+)'?", out)
    card = re.search(r"Card type\s*:\s*(.+)", out)
    info = {
        "driver": drv.group(1) if drv else "?",
        "card": card.group(1).strip() if card else "?",
        "pixfmt": pix.group(1) if pix else "?",
    }
    info["hw_encoder"] = info["pixfmt"].upper().startswith("MPEG")
    info["inputs"] = list_inputs(cfg)
    return info


def list_inputs(cfg):
    r = v4l2(cfg, "--list-inputs")
    inputs = []
    if r.returncode == 0:
        idx, name = None, None
        for line in r.stdout.splitlines():
            m = re.search(r"Input\s*:\s*(\d+)", line)
            if m:
                if idx is not None:
                    inputs.append((idx, name or ""))
                idx, name = int(m.group(1)), ""
            m = re.search(r"Name\s*:\s*(.+)", line)
            if m and idx is not None:
                name = m.group(1).strip()
        if idx is not None:
            inputs.append((idx, name or ""))
    return inputs


def resolve_input_index(cfg, want):
    """Map 'television'/'composite'/'svideo' to a device input index."""
    inputs = list_inputs(cfg)
    if not inputs:
        return 0
    if want == "television":
        for i, name in inputs:
            if "tele" in name.lower() or "tuner" in name.lower():
                return i
        return 0
    keys = INPUT_CHANNELS[want]["match"]
    for i, name in inputs:
        low = name.lower()
        if any(k in low for k in keys):
            return i
    raise ChannelError(f"device has no input matching '{want}'; available: "
                       + ", ".join(f"{i}:{n}" for i, n in inputs))


def set_standard(cfg):
    # Try a few spellings; drivers/v4l2-ctl versions vary.
    for val in (cfg["STANDARD"], "ntsc-m", "NTSC-M", "0x1000"):
        if v4l2(cfg, f"--set-standard={val}").returncode == 0:
            return True
    return False


def set_freq(cfg, mhz):
    """Tune to `mhz` and confirm the tuner actually moved there.
    Some tuners accept --set-freq (exit 0) but stay put -- e.g. an xc3028 whose
    firmware failed to load reads back 0 MHz, which would otherwise look exactly
    like an empty channel."""
    r = v4l2(cfg, f"--set-freq={mhz:.4f}")
    if r.returncode != 0:
        raise ChannelError(f"set-freq failed: {r.stderr.strip() or r.stdout.strip()}")
    r = v4l2(cfg, "--get-freq")
    m = re.search(r"\(([\d.]+) MHz\)", r.stdout) if r.returncode == 0 else None
    if m is None:
        return                      # driver can't report it; trust set-freq
    got = float(m.group(1))
    if abs(got - mhz) > 0.0625:     # V4L2 tuner step is 62.5 kHz
        raise ChannelError(f"tuner did not tune: asked for {mhz:.3f} MHz, device reports "
                           f"{got:.3f} MHz (tuner firmware missing? check dmesg)")


def tune(cfg, chan):
    """Select input, standard, and (for tuner channels) frequency."""
    check_dvb_idle(cfg, chan["kind"] == "tuner")
    idx = resolve_input_index(cfg, chan["input"])
    v4l2(cfg, f"--set-input={idx}")
    set_standard(cfg)
    if chan["kind"] == "tuner":
        set_freq(cfg, chan["freq"])


def get_signal(cfg):
    """Return (signal_pct, afc_hz) or (None, None)."""
    r = v4l2(cfg, "--get-tuner")
    if r.returncode != 0:
        return None, None
    m = re.search(r"Signal strength/AFC\s*:\s*(\d+)%\s*/\s*(-?\d+)", r.stdout)
    if m:
        return int(m.group(1)), int(m.group(2))
    return None, None


# --------------------------------------------------------------------------- #
#  Locking (single tuner -> mutual exclusion between stream and scan)
# --------------------------------------------------------------------------- #
import fcntl


class TunerLock:
    def __init__(self, path, wait=0):
        self.path = path
        self.wait = float(wait)
        self.fh = None

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.fh = open(self.path, "w")
        deadline = time.time() + self.wait
        while True:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if time.time() >= deadline:
                    self.fh.close()
                    self.fh = None
                    raise ChannelError("tuner is busy (another stream/scan holds the lock)")
                time.sleep(0.25)

    def __exit__(self, *a):
        if self.fh:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_UN)
            finally:
                self.fh.close()


# --------------------------------------------------------------------------- #
#  Streaming  (this is what TVHeadend's pipe:// mux invokes)
# --------------------------------------------------------------------------- #
def build_ffmpeg_cmd(cfg, info):
    """Return the ffmpeg argv that writes MPEG-TS to stdout."""
    ff = cfg["FFMPEG"]
    acodec = cfg["AUDIO_CODEC"].lower()
    aargs = {
        "copy": ["-c:a", "copy"],
        "mp2":  ["-c:a", "mp2", "-b:a", "224k"],
        "ac3":  ["-c:a", "ac3", "-b:a", "224k"],
    }.get(acodec, ["-c:a", "copy"])

    if info["hw_encoder"]:
        # Device already emits an MPEG-2 program stream; just demux + remux to TS.
        base = [ff, "-hide_banner", "-loglevel", "error",
                "-fflags", "+genpts", "-f", "mpeg", "-i", cfg["DEVICE"],
                "-c:v", "copy", *aargs,
                "-f", "mpegts", "-mpegts_flags", "+resend_headers", "pipe:1"]
        if cfg["CAPTURE_VIA_CAT"] == "1":
            base[base.index(cfg["DEVICE"])] = "pipe:0"   # read from cat instead
        return base

    # Raw device: software-encode video + capture audio via ALSA.
    adev = cfg["RAW_AUDIO_DEV"] or autodetect_alsa(cfg, info)
    cmd = [ff, "-hide_banner", "-loglevel", "error",
           "-f", "v4l2", "-i", cfg["DEVICE"]]
    if adev:
        cmd += ["-f", "alsa", "-ac", "2", "-ar", "48000", "-i", adev]
    # yuv420p: raw cards capture 4:2:2 (YUYV), which would make this MPEG-2 4:2:2 profile --
    # a studio format that GPU decoders (VAAPI) and many TVs/set-top boxes can't play.
    cmd += ["-c:v", "mpeg2video", "-b:v", cfg["RAW_VBITRATE"], "-pix_fmt", "yuv420p",
            "-filter:v", "yadif=0:-1:0", "-aspect", cfg["RAW_ASPECT"]]
    cmd += (aargs if acodec != "copy" else ["-c:a", "mp2", "-b:a", "224k"])
    cmd += ["-f", "mpegts", "pipe:1"]
    return cmd


SYS_ROOT = "/sys"
USB_INTERFACE = re.compile(r"^\d+-[\d.]+:\d+\.\d+$")   # e.g. 1-1:1.0 (vs a USB device, 1-1)


def _hw_device(sysdev):
    """The physical device behind a sysfs device path: a USB interface collapses to its
    USB device (video and audio may sit on sibling interfaces); PCI paths stay as-is."""
    return os.path.dirname(sysdev) if USB_INTERFACE.match(os.path.basename(sysdev)) else sysdev


def _video_hw_device(cfg):
    """The physical device (sysfs path) behind cfg DEVICE, or None if sysfs doesn't say."""
    node = os.path.basename(os.path.realpath(cfg["DEVICE"]))
    vdev = os.path.join(SYS_ROOT, "class", "video4linux", node, "device")
    if not os.path.exists(vdev):
        return None
    return _hw_device(os.path.realpath(vdev))


def alsa_from_sysfs(cfg):
    """ALSA capture device on the same physical device as the video node, via sysfs."""
    want = _video_hw_device(cfg)
    if want is None:
        return ""
    sound = os.path.join(SYS_ROOT, "class", "sound")
    try:
        cards = sorted(n for n in os.listdir(sound) if re.fullmatch(r"card\d+", n))
    except OSError:
        return ""
    for card in cards:
        cdir = os.path.join(sound, card)
        if _hw_device(os.path.realpath(os.path.join(cdir, "device"))) != want:
            continue
        pcms = sorted((int(m.group(2)), int(m.group(1))) for m in
                      (re.fullmatch(r"pcmC(\d+)D(\d+)c", n) for n in os.listdir(cdir)) if m)
        if pcms:
            devno, cardno = pcms[0]
            return f"hw:{cardno},{devno}"
    return ""


PROC_ROOT = "/proc"


def dvb_users(cfg):
    """Who has the DVB side of the same physical device open.

    Returns {kind: [(pid, comm), ...]} for kind in frontend/demux/dvr/net. The DVB nodes
    come from sysfs (same USB/PCI device as DEVICE); open files are matched by device
    number in /proc/*/fd, so it works across a container's mount namespace. Processes of
    other users (unreadable /proc/PID/fd) are not seen."""
    want = _video_hw_device(cfg)
    if want is None:
        return {}
    dvb = os.path.join(SYS_ROOT, "class", "dvb")
    nodes = {}
    try:
        names = os.listdir(dvb)
    except OSError:
        return {}
    for name in names:
        m = re.fullmatch(r"dvb\d+\.([a-z]+)\d+", name)
        if not m or _hw_device(os.path.realpath(os.path.join(dvb, name, "device"))) != want:
            continue
        try:
            with open(os.path.join(dvb, name, "dev")) as fh:
                major, minor = (int(x) for x in fh.read().split(":"))
        except (OSError, ValueError):
            continue
        nodes[os.makedev(major, minor)] = m.group(1)
    users = {}
    if not nodes:
        return users
    for pid in sorted((p for p in os.listdir(PROC_ROOT) if p.isdigit()), key=int):
        if int(pid) == os.getpid():
            continue
        fddir = os.path.join(PROC_ROOT, pid, "fd")
        try:
            fds = os.listdir(fddir)
        except OSError:
            continue
        for fd in fds:
            try:
                st = os.stat(os.path.join(fddir, fd))
            except OSError:
                continue
            kind = nodes.get(st.st_rdev) if stat.S_ISCHR(st.st_mode) else None
            if kind:
                try:
                    with open(os.path.join(PROC_ROOT, pid, "comm")) as fh:
                        comm = fh.read().strip()
                except OSError:
                    comm = "?"
                if (int(pid), comm) not in users.setdefault(kind, []):
                    users[kind].append((int(pid), comm))
    return users


def check_dvb_idle(cfg, rf):
    """Refuse analog use while the DVB side of the same tuner is busy (DVB_GUARD=1).

    On hybrid cards whose analog and digital sides share one tuner (em28xx + xc3028 in
    the Pinnacle 800e) the driver doesn't stop both being used. Retuning the analog side
    while anything holds the DVB frontend open -- even an idle TVHeadend -- makes the
    tuner flip between analog and ATSC firmware and wedges the card's I2C bus until it is
    unplugged. Line inputs don't retune, so for them only active DVB reception
    (demux/dvr open) counts."""
    if cfg["DVB_GUARD"] != "1":
        return
    users = dvb_users(cfg)
    busy = ("frontend", "demux", "dvr") if rf else ("demux", "dvr")
    hits = [(k, pid, comm) for k in busy for pid, comm in users.get(k, [])]
    if not hits:
        return
    who = ", ".join(sorted({f"{comm} (pid {pid}) has the DVB {k} open" for k, pid, comm in hits}))
    raise ChannelError(
        f"the digital (DVB) side of this tuner is in use: {who}. Analog and digital share one "
        "tuner on this device and using both at once can wedge it until it is unplugged. In "
        "TVHeadend, turn on 'Power save' for this adapter (it then closes the tuner when idle) "
        "or disable the adapter. Set DVB_GUARD=0 to skip this check.")


def autodetect_alsa(cfg, info):
    """ALSA device for the raw path: the card on the same USB/PCI device as the video
    node, else an `arecord -l` card named like the tuner/driver, else "" (no audio).
    Never guesses the first card -- that is usually the host's own sound chip."""
    adev = alsa_from_sysfs(cfg)
    if adev:
        return adev
    r = run(["arecord", "-l"])
    if r.returncode != 0:
        return ""
    want = [w.lower() for w in (info["card"].split()[:1] + [info["driver"]]) if w != "?"]
    for line in r.stdout.splitlines():
        m = re.search(r"card (\d+):\s*(\S+)\s*\[([^\]]*)\].*device (\d+)", line)
        if m:
            names = (m.group(2) + " " + m.group(3)).lower()
            if any(w in names for w in want):
                return f"hw:{m.group(1)},{m.group(4)}"
    return ""


try:
    import ctypes
    _LIBC = ctypes.CDLL(None)          # resolved in the parent; used in the child after fork
except Exception:
    _LIBC = None


def _die_with_parent():
    """Popen preexec_fn: ask the kernel to SIGKILL this child when ntsc-tvh dies, even if
    ntsc-tvh itself is SIGKILLed, so a capture process can never outlive it and keep the
    device busy. Linux-only (prctl PR_SET_PDEATHSIG); silently skipped elsewhere."""
    try:
        _LIBC.prctl(1, signal.SIGKILL)          # 1 = PR_SET_PDEATHSIG
    except Exception:
        pass


def _stop(procs, grace):
    """SIGTERM every live child, give them `grace` seconds, then SIGKILL the rest."""
    for p in procs:
        if p.poll() is None:
            p.terminate()
    deadline = time.monotonic() + grace
    for p in procs:
        try:
            p.wait(timeout=max(0.0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()


def supervise(cfg, cmd, lock, via_cat):
    """Run ffmpeg (fed by `cat DEV` when via_cat) as children and return an exit code.

    ntsc-tvh stays the process TVHeadend started, so TVHeadend's stop signal lands here.
    On SIGTERM/SIGINT/SIGHUP the children get SIGTERM, then SIGKILL after STOP_GRACE --
    ffmpeg itself can't be trusted to exit (e.g. ffmpeg 6.1 with an em28xx ALSA input
    blocks forever on audio once video stops). ffmpeg inherits our stdout, so the stream
    goes straight to TVHeadend, and it also inherits the tuner lock, so the lock is only
    released once every process using the tuner is gone."""
    stop = []

    def on_signal(signum, frame):
        stop.append(signum)

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, on_signal)
    procs = []
    try:
        stdin = None
        if via_cat:
            cat = subprocess.Popen(["cat", cfg["DEVICE"]], stdout=subprocess.PIPE,
                                   preexec_fn=_die_with_parent)
            procs.append(cat)
            stdin = cat.stdout
        ff = subprocess.Popen(cmd, stdin=stdin, pass_fds=(lock.fh.fileno(),),
                              preexec_fn=_die_with_parent)
        procs.insert(0, ff)
        if via_cat:
            cat.stdout.close()                   # ffmpeg holds the read end now
        while not stop:
            try:
                rc = ff.wait(timeout=0.25)
                break
            except subprocess.TimeoutExpired:
                pass
        else:
            rc = 128 + stop[0]
    finally:
        _stop(procs, float(cfg["STOP_GRACE"]))
    return 128 - rc if rc < 0 else rc            # killed by signal N -> 128+N, like a shell


def cmd_stream(cfg, args):
    chan = parse_channel(args.channel)
    check_dvb_idle(cfg, chan["kind"] == "tuner")   # before device_info() opens the node
    info = device_info(cfg)
    wait = float(args.wait if args.wait is not None else cfg["SCAN_LOCK_WAIT"])
    with TunerLock(cfg["LOCK_FILE"], wait=wait) as lock:
        tune(cfg, chan)
        if cfg["VIDEO_BITRATE"] and info["hw_encoder"]:
            v4l2(cfg, f"--set-ctrl=video_bitrate={cfg['VIDEO_BITRATE']}")
        time.sleep(0.4)  # let the encoder settle before TVH starts reading
        # cmd already reads "pipe:0" when the cat path is in use (see build_ffmpeg_cmd).
        cmd = build_ffmpeg_cmd(cfg, info)
        via_cat = info["hw_encoder"] and cfg["CAPTURE_VIA_CAT"] == "1"
        # Status line for interactive runs only: TVHeadend logs every line a pipe writes
        # to stderr at ERROR level. Real errors (ours and ffmpeg's) still go to stderr.
        if sys.stderr.isatty():
            sys.stderr.write(f"ntsc-tvh: streaming {chan['id']} "
                             f"({'tuner '+format(chan['freq'],'.3f')+' MHz' if chan['freq'] else chan['input']}) "
                             f"via {'HW-MPEG' if info['hw_encoder'] else 'raw-encode'}\n")
            sys.stderr.flush()
        rc = supervise(cfg, cmd, lock, via_cat)
    sys.exit(rc)


# --------------------------------------------------------------------------- #
#  Scanning
# --------------------------------------------------------------------------- #
FRAME_W, FRAME_H = 160, 120


def capture_gray(cfg, info, frames=6):
    """Grab `frames` gray 160x120 frames (2 per second) and return the raw bytes."""
    # Same input path as `stream`: on some ffmpeg builds the MPEG node read directly
    # is empty, which would make every channel look like a flat screen.
    via_cat = info["hw_encoder"] and cfg["CAPTURE_VIA_CAT"] == "1"
    if info["hw_encoder"]:
        src = ["-f", "mpeg", "-i", "pipe:0" if via_cat else cfg["DEVICE"]]
    else:
        src = ["-f", "v4l2", "-i", cfg["DEVICE"]]
    cmd = [cfg["FFMPEG"], "-hide_banner", "-loglevel", "error", *src,
           "-an", "-vf", f"fps=2,scale={FRAME_W}:{FRAME_H},format=gray",
           "-frames:v", str(frames), "-f", "rawvideo", "pipe:1"]
    cat = (subprocess.Popen(["cat", cfg["DEVICE"]], stdout=subprocess.PIPE,
                            preexec_fn=_die_with_parent) if via_cat else None)
    try:
        r = subprocess.run(cmd, stdin=cat.stdout if cat else None,
                           capture_output=True, timeout=8)
    except subprocess.TimeoutExpired:
        return b""
    finally:
        if cat:
            # cat never sees EOF on a capture node; stop it once ffmpeg has its frames.
            cat.kill()
            cat.wait()
            cat.stdout.close()
    return r.stdout


def _std(frame):
    # mean / std-dev from a 256-bin histogram (fast, stdlib only)
    hist = [frame.count(v) for v in range(256)]
    n = len(frame)
    mean = sum(v * c for v, c in enumerate(hist)) / n
    return (sum(c * (v - mean) ** 2 for v, c in enumerate(hist)) / n) ** 0.5


def _rms_diff(a, b):
    return (sum((x - y) ** 2 for x, y in zip(a, b)) / min(len(a), len(b))) ** 0.5


def picture_metrics(data, var_min):
    """Tell a picture from a flat screen and from snow, using gray frames from capture_gray().

    var    max luma std-dev. Flat 'no signal' screens (forced blue/black) are ~0.
    noise  median over frames with contrast (std >= var_min) of the difference between
           vertically adjacent pixels relative to the frame's std-dev. Real images are
           locally smooth; snow is not (>= 0.67 on an 800e). Vertical only: analog snow
           is streaked along the lines, so it looks smooth horizontally.
    motion median over consecutive frame pairs (both with contrast, duplicates skipped)
           of the frame-to-frame difference relative to std-dev. Snow is new every frame
           (>= 1.14); most pictures change little in half a second.
    Calibrated on 88 snow/noise samples from an 800e (two 68-channel scans plus captures)
    and 16 live ATSC channels: snow fails both tests, every picture passes at least one
    (busiest moving picture: noise 0.53; steadiest-needed picture: motion 0.80)."""
    fsize = FRAME_W * FRAME_H
    frames = [data[i:i + fsize] for i in range(0, len(data) - fsize + 1, fsize)]
    stds = [_std(f) for f in frames]
    noise, motion = [], []
    for i, (f, sd) in enumerate(zip(frames, stds)):
        if sd < var_min:
            continue
        noise.append(_rms_diff(f, f[FRAME_W:]) / sd)
        if i and stds[i - 1] >= var_min:
            m = _rms_diff(f, frames[i - 1]) / sd
            if m > 0.01:                         # the fps filter repeats frames now and then
                motion.append(m)
    return {"var": max(stds, default=0.0),
            "noise": statistics.median(noise) if noise else None,
            "motion": statistics.median(motion) if motion else None}


def looks_like_picture(m, cfg):
    if m["var"] < float(cfg["SCAN_VAR_MIN"]) or m["noise"] is None:
        return False
    return (m["noise"] < float(cfg["SCAN_NOISE_MAX"])
            or (m["motion"] is not None and m["motion"] < float(cfg["SCAN_MOTION_MAX"])))


def is_active(cfg, info, chan, method, thr):
    sig, afc = get_signal(cfg)
    sig_ok = (sig is not None and sig >= thr)
    if method == "signal":
        return sig_ok, {"signal": sig, "afc": afc}
    m = picture_metrics(capture_gray(cfg, info), float(cfg["SCAN_VAR_MIN"]))
    vid_ok = looks_like_picture(m, cfg)
    metrics = {"signal": sig, "afc": afc,
               **{k: (None if v is None else round(v, 2 if k != "var" else 1)) for k, v in m.items()}}
    if method == "video":
        return vid_ok, metrics
    return (sig_ok and vid_ok), metrics


def cmd_scan(cfg, args):
    tables = args.tables.split(",") if args.tables else cfg["SCAN_TABLES"].split(",")
    tables = [t.strip() for t in tables if t.strip()]
    for t in tables:
        if t not in TABLES:
            sys.exit(f"unknown table '{t}' (have: {', '.join(TABLES)})")
    method = (args.method or cfg["SCAN_METHOD"]).lower()
    thr = int(args.threshold if args.threshold is not None else cfg["SCAN_THRESHOLD"])
    dwell = float(args.dwell if args.dwell is not None else cfg["SCAN_DWELL"])
    wait = float(args.wait if args.wait is not None else cfg["SCAN_LOCK_WAIT"])

    check_dvb_idle(cfg, rf=True)                    # before device_info() opens the node
    info = device_info(cfg)
    cands = all_channels(tables)
    found = []
    sys.stderr.write(f"Scanning {len(cands)} channels across [{', '.join(tables)}] "
                     f"using method='{method}' threshold={thr}% ...\n")

    try:
        with TunerLock(cfg["LOCK_FILE"], wait=wait):
            set_standard(cfg)
            idx = resolve_input_index(cfg, "television")
            v4l2(cfg, f"--set-input={idx}")
            for c in cands:
                # A tuner that won't tune (or one the DVB side grabbed mid-scan) is a device
                # fault, not an empty channel: abort, keeping the previous state/M3U.
                check_dvb_idle(cfg, rf=True)
                set_freq(cfg, c["freq"])
                time.sleep(dwell)
                active, metrics = is_active(cfg, info, c, method, thr)
                tag = "ACTIVE" if active else "  --  "
                extra = " ".join(f"{k}={v}" for k, v in metrics.items() if v is not None)
                sys.stderr.write(f"  [{tag}] {c['id']:<16} {c['freq']:>8.3f} MHz  {extra}\n")
                if active:
                    rec = dict(c); rec.update(metrics)
                    found.append(rec)
    except ChannelError as exc:
        sys.exit(f"scan aborted: {exc}")

    state = {
        "device": cfg["DEVICE"],
        "card": info["card"],
        "scanned_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "method": method, "threshold": thr, "tables": tables,
        "active": found,
    }
    save_state(cfg, state)
    sys.stderr.write(f"\nFound {len(found)} active channel(s). Saved to {cfg['STATE_FILE']}.\n")
    if not args.no_m3u:
        write_m3u(cfg, state)
        sys.stderr.write(f"Wrote playlist {cfg['M3U_FILE']}.\n")


# --------------------------------------------------------------------------- #
#  State + M3U
# --------------------------------------------------------------------------- #
def save_state(cfg, state):
    os.makedirs(os.path.dirname(cfg["STATE_FILE"]), exist_ok=True)
    tmp = cfg["STATE_FILE"] + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh, indent=2)
    os.replace(tmp, cfg["STATE_FILE"])


def load_state(cfg):
    try:
        with open(cfg["STATE_FILE"]) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def self_path(cfg):
    p = cfg["SELF_PATH"].strip()
    if p:
        return p
    return os.path.realpath(sys.argv[0])


def m3u_entries(cfg, state):
    """Yield (chan_dict) for active tuner channels + (optionally) line inputs."""
    if state:
        for c in state.get("active", []):
            yield c
    if cfg["INPUTS_ALWAYS_ACTIVE"] == "1":
        for name in INPUT_CHANNELS:
            yield parse_channel(f"input:{name}")


def write_m3u(cfg, state):
    sp = self_path(cfg)
    lines = ["#EXTM3U"]
    for c in m3u_entries(cfg, state):
        cid = c["id"]
        label = c.get("label", cid)
        group = c.get("group", "NTSC")
        # The pipe URL IS the mux identity in TVHeadend's auto-network -> keep it
        # stable (no scan timestamps / volatile params) so rescans don't churn muxes.
        url = f"pipe://{sp} stream {cid}"
        lines.append(f'#EXTINF:-1 tvg-id="{cid}" tvg-name="{label}" group-title="{group}",{label}')
        lines.append(url)
    os.makedirs(os.path.dirname(cfg["M3U_FILE"]), exist_ok=True)
    tmp = cfg["M3U_FILE"] + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("\n".join(lines) + "\n")
    os.replace(tmp, cfg["M3U_FILE"])


def cmd_m3u(cfg, args):
    state = load_state(cfg)
    if not state and cfg["INPUTS_ALWAYS_ACTIVE"] != "1":
        sys.exit("no scan state found; run `ntsc-tvh scan` first")
    if args.output:
        cfg = dict(cfg); cfg["M3U_FILE"] = args.output
    write_m3u(cfg, state)
    if args.stdout:
        with open(cfg["M3U_FILE"]) as fh:
            sys.stdout.write(fh.read())
    else:
        print(f"wrote {cfg['M3U_FILE']}")


# --------------------------------------------------------------------------- #
#  list / status / tune / signal / doctor
# --------------------------------------------------------------------------- #
def cmd_list(cfg, args):
    if args.active_only:
        state = load_state(cfg)
        chans = list(m3u_entries(cfg, state))
        if not chans:
            print("no active channels (run a scan first)")
            return
    else:
        tables = args.tables.split(",") if args.tables else list(TABLES)
        chans = all_channels([t.strip() for t in tables if t.strip()])
        if cfg["INPUTS_ALWAYS_ACTIVE"] == "1":
            chans += [parse_channel(f"input:{n}") for n in INPUT_CHANNELS]
    if args.json:
        print(json.dumps(chans, indent=2))
        return
    for c in chans:
        freq = f"{c['freq']:>8.3f} MHz" if c.get("freq") else "  line input"
        print(f"{c['id']:<18} {freq}   {c['label']}")


def cmd_tune(cfg, args):
    chan = parse_channel(args.channel)
    with TunerLock(cfg["LOCK_FILE"], wait=float(args.wait or 0)):
        tune(cfg, chan)
    print(f"tuned {chan['id']}"
          + (f" -> {chan['freq']:.3f} MHz" if chan["freq"] else f" (input {chan['input']})"))


def cmd_signal(cfg, args):
    chan = parse_channel(args.channel)
    with TunerLock(cfg["LOCK_FILE"], wait=float(args.wait or 0)):
        tune(cfg, chan)
        if chan["kind"] != "tuner":
            print(f"{chan['id']}: selected; line inputs have no RF signal to measure")
            return
        time.sleep(float(cfg["SCAN_DWELL"]))
        sig, afc = get_signal(cfg)
    if sig is None:
        print(f"{chan['id']}: tuner reported no signal metric")
    else:
        print(f"{chan['id']}  {chan['freq']:.3f} MHz  signal={sig}%  afc={afc} Hz")


def cmd_status(cfg, args):
    state = load_state(cfg)
    if not state:
        print("no scan has been run yet")
    else:
        print(f"device:     {state.get('device')}  ({state.get('card','?')})")
        print(f"last scan:  {state.get('scanned_at')}  "
              f"method={state.get('method')} threshold={state.get('threshold')}%")
        print(f"tables:     {', '.join(state.get('tables', []))}")
        print(f"active:     {len(state.get('active', []))} channel(s)")
    print(f"timer:      {timer_status()}")


def cmd_doctor(cfg, args):
    ok = True
    def chk(label, good, detail=""):
        nonlocal ok
        ok = ok and good
        print(f"  [{'OK' if good else '!!'}] {label}" + (f"  {detail}" if detail else ""))

    print("ntsc-tvh doctor")
    chk("ffmpeg present", shutil.which(cfg["FFMPEG"]) is not None, cfg["FFMPEG"])
    chk("v4l2-ctl present", shutil.which(cfg["V4L2CTL"]) is not None, cfg["V4L2CTL"])
    chk("device node exists", os.path.exists(cfg["DEVICE"]), cfg["DEVICE"])
    if os.path.exists(cfg["DEVICE"]):
        chk("device readable", os.access(cfg["DEVICE"], os.R_OK),
            "add the tvheadend user to the 'video' group if not")
        users = dvb_users(cfg) if cfg["DVB_GUARD"] == "1" else {}
        held = "; ".join(f"{k}: " + ", ".join(f"{c} ({p})" for p, c in v)
                         for k, v in sorted(users.items()))
        if "demux" in users or "dvr" in users:
            # Even opening the analog node switches an em28xx out of digital mode.
            chk("DVB side of this tuner idle", False,
                f"{held} -- digital is receiving, so the device probe was skipped")
        else:
            try:
                info = device_info(cfg)
                chk("driver detected", info["driver"] != "?", info["driver"])
                print(f"       card:    {info['card']}")
                print(f"       pixfmt:  {info['pixfmt']}  "
                      f"({'hardware MPEG encoder' if info['hw_encoder'] else 'raw frames -> software encode'})")
                ins = ", ".join(f"{i}:{n}" for i, n in info["inputs"]) or "none"
                print(f"       inputs:  {ins}")
                if not info["hw_encoder"]:
                    adev = cfg["RAW_AUDIO_DEV"] or autodetect_alsa(cfg, info)
                    chk("ALSA audio device (raw path)", bool(adev), adev or "set RAW_AUDIO_DEV")
            except ChannelError as exc:
                chk("device probe", False, str(exc))
            if users:
                chk("DVB side of this tuner idle", False,
                    f"{held} -- RF tuning will be refused (see README: 'Power save')")
    print("status:", "all good" if ok else "issues found")
    sys.exit(0 if ok else 1)


# --------------------------------------------------------------------------- #
#  systemd timer for periodic rescan
# --------------------------------------------------------------------------- #
SERVICE_UNIT = "/etc/systemd/system/ntsc-tvh-scan.service"
TIMER_UNIT = "/etc/systemd/system/ntsc-tvh-scan.timer"


def timer_status():
    if not os.path.exists(TIMER_UNIT):
        return "not installed (rescan = none)"
    r = run(["systemctl", "is-enabled", "ntsc-tvh-scan.timer"])
    return f"installed, {r.stdout.strip() or 'unknown'} (daily rescan)"


def cmd_install_timer(cfg, args):
    if os.geteuid() != 0:
        sys.exit("install-timer must be run as root (sudo)")
    if args.period == "none":
        for u in (TIMER_UNIT, SERVICE_UNIT):
            if os.path.exists(u):
                os.remove(u)
        run(["systemctl", "disable", "--now", "ntsc-tvh-scan.timer"])
        run(["systemctl", "daemon-reload"])
        print("rescan timer removed (period = none)")
        return

    sp = self_path(cfg)
    user = args.user
    svc = f"""[Unit]
Description=Rescan NTSC analog channels and refresh the TVHeadend playlist
After=network.target

[Service]
Type=oneshot
User={user}
ExecStart={sp} scan --wait 30
# scan already writes the M3U; this is just an explicit safety net:
ExecStartPost={sp} m3u
"""
    tmr = """[Unit]
Description=Daily NTSC analog channel rescan

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
"""
    with open(SERVICE_UNIT, "w") as fh:
        fh.write(svc)
    with open(TIMER_UNIT, "w") as fh:
        fh.write(tmr)
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now", "ntsc-tvh-scan.timer"])
    print(f"installed daily rescan timer (runs as {user}); next run:")
    r = run(["systemctl", "list-timers", "ntsc-tvh-scan.timer", "--no-pager"])
    print(r.stdout.strip() or "  (use `systemctl list-timers` to verify)")


# --------------------------------------------------------------------------- #
#  CLI
# --------------------------------------------------------------------------- #
def build_parser():
    p = argparse.ArgumentParser(prog="ntsc-tvh",
                                description="Analog NTSC tuning/streaming/scanning for TVHeadend pipe:// muxes")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("doctor", help="check device, codecs, permissions")
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("list", help="list channels")
    sp.add_argument("--tables", help="comma list, e.g. us-bcast,us-cable")
    sp.add_argument("--active-only", action="store_true", help="only channels from the last scan")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("tune", help="tune only (debug)")
    sp.add_argument("channel")
    sp.add_argument("--wait", type=float, help="seconds to wait for tuner lock")
    sp.set_defaults(func=cmd_tune)

    sp = sub.add_parser("signal", help="tune and report signal strength (debug)")
    sp.add_argument("channel")
    sp.add_argument("--wait", type=float)
    sp.set_defaults(func=cmd_signal)

    sp = sub.add_parser("stream", help="tune + emit MPEG-TS on stdout (TVHeadend calls this)")
    sp.add_argument("channel")
    sp.add_argument("--wait", type=float, help="seconds to wait for tuner lock")
    sp.set_defaults(func=cmd_stream)

    sp = sub.add_parser("scan", help="scan channels and save active ones")
    sp.add_argument("--tables", help="comma list to scan (default from config)")
    sp.add_argument("--method", choices=["signal", "video", "both"])
    sp.add_argument("--threshold", type=int, help="signal %% threshold")
    sp.add_argument("--dwell", type=float, help="settle seconds per channel")
    sp.add_argument("--wait", type=float, help="seconds to wait for tuner lock (0 = abort if busy)")
    sp.add_argument("--no-m3u", action="store_true", help="don't regenerate the playlist")
    sp.set_defaults(func=cmd_scan)

    sp = sub.add_parser("m3u", help="write the M3U playlist of active channels")
    sp.add_argument("--output", help="output path (default from config)")
    sp.add_argument("--stdout", action="store_true", help="also print the playlist")
    sp.set_defaults(func=cmd_m3u)

    sp = sub.add_parser("install-timer", help="install/remove the periodic rescan timer")
    sp.add_argument("--period", choices=["24h", "none"], default="24h",
                    help="24h = daily rescan, none = remove the timer")
    sp.add_argument("--user", default="hts", help="user to run the scan as (default: hts)")
    sp.set_defaults(func=cmd_install_timer)

    sp = sub.add_parser("status", help="show last-scan summary")
    sp.set_defaults(func=cmd_status)
    return p


def main():
    cfg = load_config()
    args = build_parser().parse_args()
    try:
        args.func(cfg, args)
    except ChannelError as exc:
        sys.exit(f"error: {exc}")
    except BrokenPipeError:
        # downstream (TVHeadend / head of pipe) went away; exit quietly
        try:
            sys.stdout.close()
        except Exception:
            pass
        os._exit(0)


if __name__ == "__main__":
    main()
